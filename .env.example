# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit secrets.
# The API validates every variable at startup and refuses to start with a clear message if one
# is missing or invalid. Placeholder secrets (starting with "change-me") are rejected when
# NODE_ENV=production.

# --- Runtime ---------------------------------------------------------------------------------
NODE_ENV=development
# Public HTTP port (product API, telemetry ingress, health endpoints).
PORT=4000
# Private port for Prometheus scrapes. Never publish or route it publicly.
INTERNAL_PORT=9464
LOG_LEVEL=info
APP_BASE_URL=http://localhost:4000
# Browser origin allowed to call the API (CORS / CSRF origin check).
WEB_ORIGIN=http://localhost:5173
# Set to true when running behind a reverse proxy (Render, nginx) so client IPs are correct.
TRUST_PROXY=false

# --- Backends (private network; local defaults match infra/compose.yaml) -----------------------
MONGODB_URI=mongodb://localhost:27017/aop
REDIS_URL=redis://localhost:6379
# Telemetry backends. Leave empty in a deployment without them: readiness then reports
# "degraded" and metrics/log features are unavailable.
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
# Optional: platform OTLP export endpoint (future use).
OTEL_COLLECTOR_ENDPOINT=http://localhost:4318

# --- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
# Signs/derives session identifiers.
SESSION_SECRET=change-me-generate-a-random-value-of-at-least-32-chars
# Server-side pepper for HMAC-SHA-256 hashing of ingestion API keys. Changing it invalidates
# every existing key.
TELEMETRY_KEY_PEPPER=change-me-generate-another-random-value-32-chars

# --- Sessions --------------------------------------------------------------------------------
# A session ends after this much inactivity (sliding), and always after the absolute lifetime.
SESSION_IDLE_TTL_MINUTES=720
SESSION_ABSOLUTE_TTL_HOURS=168

# --- Ingestion keys --------------------------------------------------------------------------
# Seconds a verified key is cached. A key revoked through another API instance keeps working
# for at most this long; the instance that revokes it rejects it immediately.
API_KEY_CACHE_TTL_SECONDS=30

# --- Telemetry pipeline --------------------------------------------------------------------
# Per-project caps on distinct metric label values; further values are recorded as "__other__".
MAX_ROUTES_PER_PROJECT=100
MAX_SERVICES_PER_PROJECT=20
# Deadline for each call to Loki / Prometheus.
BACKEND_TIMEOUT_MS=5000

# --- Plans and quotas ------------------------------------------------------------------------
# Seconds an organization's plan limits are cached on the ingestion path. A plan change takes
# effect within this time.
PLAN_CACHE_TTL_SECONDS=30

# --- Alerts and webhooks ----------------------------------------------------------------------
# The alert evaluator and webhook sender run inside the API process. Set to false if you run a
# separate worker instead.
ALERT_WORKER_ENABLED=true
ALERT_TICK_MS=5000
WEBHOOK_TIMEOUT_MS=5000
# DEVELOPMENT ONLY: allow webhooks to private/loopback addresses (e.g. the demo receiver on
# localhost). The API refuses to start with this enabled in production (SSRF protection).
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# Optional: key material (32+ chars) for encrypting webhook signing secrets at rest.
# Defaults to SESSION_SECRET. Changing it makes existing signing secrets unreadable.
# WEBHOOK_ENCRYPTION_KEY=

# --- Web app -------------------------------------------------------------------------------
# Directory of the built web app. When set, the API serves the UI from the same origin.
# Set automatically in the Docker image; leave unset in development (Vite serves the UI).
# WEB_DIST_DIR=apps/web/dist

# --- Health checks -------------------------------------------------------------------------
HEALTH_CHECK_TIMEOUT_MS=2000

# --- Operator ------------------------------------------------------------------------------
# Bearer token (32+ chars) for the operator health view at /operator and
# GET /api/v1/operator/health. Leave unset to disable it on the public port; the internal
# listener (INTERNAL_PORT) always serves /operator/health without a token.
# OPERATOR_TOKEN=
