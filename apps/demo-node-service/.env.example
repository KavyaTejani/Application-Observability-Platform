# Copy to .env (git-ignored) and paste a project ingestion key from the web app.
AOP_ENDPOINT=http://localhost:4000
AOP_API_KEY=
AOP_SERVICE_NAME=demo-store
# Must match the project's environment (or leave empty).
AOP_ENVIRONMENT=development

PORT=3001
# Share of /checkout requests that fail with 500 (0–1). Raise it to trigger error-rate alerts.
DEMO_ERROR_RATE=0.05
# Extra latency added to every request, in ms. Raise it to trigger latency alerts.
DEMO_EXTRA_LATENCY_MS=0

# Traffic generator
TRAFFIC_TARGET=http://localhost:3001
TRAFFIC_RPS=5
TRAFFIC_DURATION_SECONDS=60
