{
  "name": "@aop/demo-node-service",
  "version": "0.1.0",
  "private": true,
  "description": "Sample Express store API instrumented with @aop/node-sdk.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=.env src/server.ts",
    "start": "tsx --conditions=source --env-file-if-exists=.env src/server.ts",
    "traffic": "tsx --conditions=source --env-file-if-exists=.env src/traffic.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.23.15"
  }
}
