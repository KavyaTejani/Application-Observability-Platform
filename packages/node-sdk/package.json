{
  "name": "@aop/node-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js SDK for the Application Observability Platform: Express middleware, structured logger, batching sender.",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
